APP_NAME=SoporteTecnico
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stderr

# --- MySQL LOCAL (contenedor Docker "db") ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=soporte_local
DB_USERNAME=soporte
DB_PASSWORD=cambiar_password
DB_ROOT_PASSWORD=cambiar_root

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Docker Hub (usuario real, solo para el nombre de la imagen) ---
DOCKERHUB_USER=usuario

# --- BD de DESTINO (red local). Credenciales las da el docente. NO subir al repo ---
GRUPO_NOMBRE=bacarlix
DEST_DB_HOST=10.0.40.136
DEST_DB_PORT=3306
DEST_DB_DATABASE=
DEST_DB_USERNAME=
DEST_DB_PASSWORD=
DEST_DB_TABLE=solicitudes_soporte
